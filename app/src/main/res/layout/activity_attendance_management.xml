<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reports_bg"
    tools:context=".AttendanceManagementActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/btnSaveAttendance"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_16"
            android:paddingBottom="16dp">

            <!-- Top header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="@string/attendance_title"
                    android:textColor="@color/dark_navy"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/btnSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_white_48"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/menu"
                        android:src="@drawable/ic_search_grey" />
                </FrameLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="20dp" />

            <!-- Month navigation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMonthYear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.05"
                    android:text="@string/month_october_2023"
                    android:textColor="@color/medium_grey"
                    android:textSize="16sp"
                    android:textAllCaps="true" />

                <ImageView
                    android:id="@+id/btnMonthPrev"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/back"
                    android:padding="4dp"
                    android:src="@drawable/ic_arrow_left" />

                <ImageView
                    android:id="@+id/btnMonthNext"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/back"
                    android:padding="4dp"
                    android:src="@drawable/ic_arrow_right" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="16dp" />

            <!-- Week date selector: 7 columns -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:id="@+id/dayMon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/day_mon"
                        android:textColor="@color/medium_grey"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/dateMon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/dark_navy"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="2" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dayTue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/day_tue"
                        android:textColor="@color/medium_grey"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/dateTue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/dark_navy"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="3" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dayWed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/day_wed"
                        android:textColor="@color/medium_grey"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/dateWed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/dark_navy"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="4" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dayThu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_date_pill_selected"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/day_thu"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/dateThu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="5" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dayFri"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/day_fri"
                        android:textColor="@color/medium_grey"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/dateFri"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/dark_navy"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="6" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/daySat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/day_sat"
                        android:textColor="@color/medium_grey"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/dateSat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/dark_navy"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="7" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/daySun"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/day_sun"
                        android:textColor="@color/medium_grey"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/dateSun"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/dark_navy"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="8" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="24dp" />

            <!-- Summary cards: 3 circular cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/attendance_summary_card_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/card_white"
                    app:cardCornerRadius="@dimen/attendance_summary_radius"
                    app:cardElevation="@dimen/attendance_mgmt_card_elevation">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/present"
                            android:textColor="@color/medium_grey"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/summaryPresent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/primary_blue"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            tools:text="24" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/attendance_summary_card_height"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/card_white"
                    app:cardCornerRadius="@dimen/attendance_summary_radius"
                    app:cardElevation="@dimen/attendance_mgmt_card_elevation">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/absent"
                            android:textColor="@color/medium_grey"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/summaryAbsent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/dark_navy"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            tools:text="3" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/attendance_summary_card_height"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/card_white"
                    app:cardCornerRadius="@dimen/attendance_summary_radius"
                    app:cardElevation="@dimen/attendance_mgmt_card_elevation">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/half_day"
                            android:textColor="@color/medium_grey"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/summaryHalfDay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/dark_navy"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            tools:text="2" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="24dp" />

            <!-- Staff list header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="@string/staff_list"
                    android:textColor="@color/dark_navy"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalWorkers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/total_29_workers"
                    android:textColor="@color/medium_grey"
                    android:textSize="14sp" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="16dp" />

            <!-- Staff list (RecyclerView scrolls with NestedScrollView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerStaff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                tools:itemCount="4"
                tools:listitem="@layout/item_attendance_management" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Save button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveAttendance"
        android:layout_width="0dp"
        android:layout_height="@dimen/save_attendance_btn_height"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        android:drawableStart="@drawable/ic_check_white"
        android:drawablePadding="12dp"
        android:drawableTint="@color/white"
        android:gravity="center"
        android:text="@string/save_attendance"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_blue"
        app:cornerRadius="@dimen/save_attendance_radius"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollContent"
        android:layout_marginTop="24dp" />

    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/card_white"
        app:elevation="8dp"
        app:itemIconTint="@color/reports_nav_colors"
        app:itemTextColor="@color/reports_nav_colors"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_attendance_management_bottom_nav" />
</androidx.constraintlayout.widget.ConstraintLayout>
