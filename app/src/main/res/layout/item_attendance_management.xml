<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_16"
    app:cardBackgroundColor="@color/card_white"
    app:cardCornerRadius="@dimen/report_card_radius"
    app:cardElevation="@dimen/attendance_mgmt_card_elevation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top row: avatar + name + subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/attendance_avatar_size"
                android:layout_height="@dimen/attendance_avatar_size">

                <View
                    android:id="@+id/avatarPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_soft_blue_circle_reports" />

                <TextView
                    android:id="@+id/avatarInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/primary_blue"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="JD" />

                <ImageView
                    android:id="@+id/avatarImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/worker_photo" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/staffName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/dark_navy"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Jordan Henderson" />

                <TextView
                    android:id="@+id/staffSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/medium_grey"
                    android:textSize="16sp"
                    tools:text="Site Supervisor • #WR-2034" />
            </LinearLayout>
        </LinearLayout>

        <!-- Segmented control: Present | Half Day | Absent -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/segment_control_height"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_segment_container"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp">

            <FrameLayout
                android:id="@+id/optionPresent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_segment_option_selected"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/textPresent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif"
                    android:text="@string/present"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/optionHalfDay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/textHalfDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif"
                    android:text="@string/half_day"
                    android:textColor="@color/medium_grey"
                    android:textSize="14sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/optionAbsent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/textAbsent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif"
                    android:text="@string/absent"
                    android:textColor="@color/medium_grey"
                    android:textSize="14sp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
