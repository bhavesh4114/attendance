<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/worker_mgmt_bg"
    tools:context=".DailyAttendanceActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/summaryBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <!-- Top header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="@dimen/back_button_circle_size"
                    android:layout_height="@dimen/back_button_circle_size"
                    android:background="@drawable/bg_circle_light_grey">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/calendar"
                        android:src="@drawable/ic_calendar" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/daily_attendance"
                        android:textColor="@color/dark_navy"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/majduri_hajri"
                        android:textColor="@color/medium_grey"
                        android:textSize="11sp"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnSearch"
                    android:layout_width="@dimen/back_button_circle_size"
                    android:layout_height="@dimen/back_button_circle_size"
                    android:background="@drawable/bg_circle_light_grey">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/menu"
                        android:src="@drawable/ic_search_grey" />
                </FrameLayout>
            </LinearLayout>

            <!-- Date selector row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="@dimen/date_circle_size"
                        android:layout_height="@dimen/date_circle_size"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_date_circle">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="sans-serif"
                            android:text="MON\n21"
                            android:gravity="center"
                            android:textColor="@color/medium_grey"
                            android:textSize="10sp"
                            android:lineSpacingExtra="-2dp" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="@dimen/date_circle_size"
                        android:layout_height="@dimen/date_circle_size"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_date_circle">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="sans-serif"
                            android:text="TUE\n22"
                            android:gravity="center"
                            android:textColor="@color/medium_grey"
                            android:textSize="10sp"
                            android:lineSpacingExtra="-2dp" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="@dimen/date_circle_size"
                        android:layout_height="@dimen/date_circle_size"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_date_circle_selected"
                        android:elevation="2dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="WED"
                                android:textColor="@color/white"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="23"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="4dp"
                                android:layout_height="4dp"
                                android:layout_marginTop="2dp"
                                android:background="@drawable/bg_date_dot" />
                        </LinearLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="@dimen/date_circle_size"
                        android:layout_height="@dimen/date_circle_size"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_date_circle">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="sans-serif"
                            android:text="THU\n24"
                            android:gravity="center"
                            android:textColor="@color/medium_grey"
                            android:textSize="10sp"
                            android:lineSpacingExtra="-2dp" />
                    </FrameLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Section header: Worker List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/worker_list"
                        android:textColor="@color/dark_navy"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/workers_total_24"
                        android:textColor="@color/medium_grey"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarkAllPresent"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_mark_all_present"
                    android:drawableStart="@drawable/ic_check_green"
                    android:drawablePadding="8dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/mark_all_present"
                    android:textColor="@color/primary_blue"
                    android:textSize="13sp"
                    app:backgroundTint="@null"
                    app:cornerRadius="@dimen/pill_radius" />
            </LinearLayout>

            <!-- Worker list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerAttendance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                tools:itemCount="4"
                tools:listitem="@layout/item_attendance_card" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom summary bar -->
    <LinearLayout
        android:id="@+id/summaryBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/primary_blue"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_16"
        app:layout_constraintBottom_toTopOf="@id/btnSaveAttendance"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_group_white" />

        <TextView
            android:id="@+id/tvPresentCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif"
            android:text="@string/present_count_18"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_clock_white" />

        <TextView
            android:id="@+id/tvTotalOt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif"
            android:text="@string/total_ot_hrs"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Save button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveAttendance"
        android:layout_width="0dp"
        android:layout_height="@dimen/add_worker_button_height"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_button_primary"
        android:drawableStart="@drawable/ic_save_white"
        android:drawablePadding="12dp"
        android:text="@string/save_attendance"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:cornerRadius="@dimen/radius_large"
        app:elevation="@dimen/card_elevation"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/card_white"
        app:elevation="8dp"
        app:itemIconTint="@color/bottom_nav_colors"
        app:itemTextColor="@color/bottom_nav_colors"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_bottom_nav" />
</androidx.constraintlayout.widget.ConstraintLayout>
