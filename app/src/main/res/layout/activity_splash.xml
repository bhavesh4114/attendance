<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_bg_dark"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    tools:context=".SplashActivity">

    <!-- Centered content block: logo + title + tagline -->
    <LinearLayout
        android:id="@+id/splashContentBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Hexagon logo + white icon -->
        <FrameLayout
            android:id="@+id/logoContainer"
            android:layout_width="@dimen/splash_logo_size"
            android:layout_height="@dimen/splash_logo_size"
            android:alpha="0"
            android:elevation="@dimen/splash_logo_elevation">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/splash_hexagon_bg"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/logoIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/splash_logo_icon_white" />

            <View
                android:id="@+id/notificationDot"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Labour Management - main title -->
        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:alpha="0"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="0.18"
            android:lineSpacingExtra="2dp"
            android:text="@string/splash_labour_management"
            android:textColor="@color/splash_text_white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:shadowColor="#40000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <!-- ADVANCED LABOR MANAGEMENT - tagline -->
        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:text="@string/splash_tagline"
            android:textColor="@color/splash_tagline_grey"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Hidden; kept for SplashActivity animation ref -->
    <View
        android:id="@+id/hajriRow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Dummy for SplashActivity animation ref -->
    <View
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Kept for animation ref; not visible -->
    <LinearLayout
        android:id="@+id/securityRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
